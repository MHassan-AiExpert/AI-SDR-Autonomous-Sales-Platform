{
  "id": "aisdrInstantlyEv",
  "name": "Instantly events",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "instantly/:token",
        "responseMode": "onReceived",
        "responseCode": 200,
        "options": { "rawBody": false }
      },
      "id": "7a2c3b1e-2e4f-4c1a-9b21-1f0a6a0c0101",
      "name": "Instantly webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "a3f1c2d4-5b6e-4f70-8a91-b2c3d4e5f601"
    },
    {
      "parameters": {
        "jsCode": "// Forward the event with the workspace token, signed so only n8n can deliver it.\nconst crypto = require('crypto');\nconst items = $input.all();\nreturn items.map((item) => {\n  const token = String(item.json.params?.token ?? '');\n  const body = JSON.stringify({ token, event: item.json.body ?? {} });\n  const timestamp = String(Math.floor(Date.now() / 1000));\n  const signature = crypto.createHmac('sha256', $env.PLATFORM_HMAC_SECRET).update(`${timestamp}.${body}`).digest('hex');\n  return { json: { timestamp, body, signature } };\n});"
      },
      "id": "7a2c3b1e-2e4f-4c1a-9b21-1f0a6a0c0102",
      "name": "Sign event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_SERVICE_URL }}/webhooks/instantly",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-timestamp", "value": "={{ $json.timestamp }}" },
            { "name": "x-signature", "value": "={{ $json.signature }}" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": { "timeout": 30000, "response": { "response": { "neverError": true } } }
      },
      "id": "7a2c3b1e-2e4f-4c1a-9b21-1f0a6a0c0103",
      "name": "Deliver to agent service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Instantly webhook": { "main": [[{ "node": "Sign event", "type": "main", "index": 0 }]] },
    "Sign event": { "main": [[{ "node": "Deliver to agent service", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "timezone": "UTC"
  },
  "active": true
}
