# Copy to infra/.env and replace every change-me value.
# Generate secrets with: openssl rand -hex 32

# --- n8n internal database -------------------------------------------------
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me
N8N_DB_POOL_SIZE=5

# --- Redis job queue ---------------------------------------------------------
REDIS_PASSWORD=change-me

# --- n8n -------------------------------------------------------------------
# Encrypts stored credentials. Never change it after first start.
N8N_ENCRYPTION_KEY=change-me
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLISHED_PORT=5678
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
N8N_LOG_LEVEL=info
N8N_EXECUTIONS_MAX_AGE_HOURS=336

# --- Workers -----------------------------------------------------------------
N8N_WORKER_REPLICAS=2
N8N_WORKER_CONCURRENCY=10

# --- Platform ----------------------------------------------------------------
# Signs requests between the web app and n8n (HMAC).
PLATFORM_HMAC_SECRET=change-me
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Agent service ------------------------------------------------------------
# Supabase > Connect > Transaction pooler URI (port 6543), with the database password.
AGENT_DATABASE_URL=change-me
AGENT_SERVICE_REPLICAS=1
AGENT_JOBS_PER_RUN=3
# Optional model overrides. Anthropic is used once ANTHROPIC_MODEL names a current model id.
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=
